{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(profile|brief|claim|asset|shot|review|release|gate|gate-run|manifest)_[a-z0-9][a-z0-9-]{1,62}$"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^profile_[a-z0-9][a-z0-9-]{1,62}$"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "valid_from": {
          "$ref": "#/$defs/date"
        },
        "valid_until": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rightsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "unverified",
            "verified",
            "restricted",
            "expired",
            "revoked"
          ]
        },
        "basis": {
          "type": "string"
        },
        "source_uri": {
          "type": "string"
        },
        "holder": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "array",
              "null"
            ]
          }
        },
        "valid_until": {
          "$ref": "#/$defs/date"
        },
        "review_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    }
  },
  "$id": "https://example.invalid/video-production/asset.schema.json",
  "title": "asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schema_version",
    "record_type",
    "status",
    "uri",
    "usage_scope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^asset_[a-z0-9][a-z0-9-]{1,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "Asset"
    },
    "status": {
      "enum": [
        "cleared",
        "unverified",
        "expired",
        "revoked"
      ]
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "usage_scope": {
      "$ref": "#/$defs/scope"
    },
    "rights_basis": {
      "type": "string"
    },
    "rights_ambiguity": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_asset_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/rightsRecord"
        },
        "model_weights": {
          "$ref": "#/$defs/rightsRecord"
        },
        "input_media": {
          "$ref": "#/$defs/rightsRecord"
        },
        "output_use": {
          "$ref": "#/$defs/rightsRecord"
        }
      }
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    },
    "manifest_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changed_at",
          "actor",
          "change",
          "previous_version"
        ],
        "properties": {
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "previous_version": {
            "$ref": "#/$defs/version"
          }
        }
      }
    }
  }
}
