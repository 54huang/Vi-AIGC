{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(profile|brief|claim|asset|shot|review|release)_[a-z0-9][a-z0-9-]{1,62}$"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^profile_[a-z0-9][a-z0-9-]{1,62}$"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "valid_from": {
          "$ref": "#/$defs/date"
        },
        "valid_until": {
          "$ref": "#/$defs/date"
        }
      }
    }
  },
  "$id": "https://example.invalid/video-production/shot.schema.json",
  "title": "shot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schema_version",
    "record_type",
    "status",
    "brief",
    "claim_ids",
    "asset_refs",
    "review_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^shot_[a-z0-9][a-z0-9-]{1,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "Shot"
    },
    "status": {
      "enum": [
        "planned",
        "approved",
        "locked",
        "rejected"
      ]
    },
    "brief": {
      "$ref": "#/$defs/ref"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(profile|brief|claim|asset|shot|review|release)_[a-z0-9][a-z0-9-]{1,62}$"
      },
      "uniqueItems": true
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(profile|brief|claim|asset|shot|review|release)_[a-z0-9][a-z0-9-]{1,62}$"
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string"
    }
  }
}
