{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(profile|brief|claim|asset|shot|review|release)_[a-z0-9][a-z0-9-]{1,62}$"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^profile_[a-z0-9][a-z0-9-]{1,62}$"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "valid_from": {
          "$ref": "#/$defs/date"
        },
        "valid_until": {
          "$ref": "#/$defs/date"
        }
      }
    }
  },
  "$id": "https://example.invalid/video-production/project-profile.schema.json",
  "title": "project_profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schema_version",
    "record_type",
    "project_name",
    "status",
    "review_requirements",
    "claim_ids",
    "asset_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^profile_[a-z0-9][a-z0-9-]{1,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "ProjectProfile"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "review_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brief": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "factuality",
              "rights",
              "creative",
              "compliance",
              "release"
            ]
          },
          "uniqueItems": true
        },
        "shot": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "factuality",
              "rights",
              "creative",
              "compliance",
              "release"
            ]
          },
          "uniqueItems": true
        },
        "asset": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "factuality",
              "rights",
              "creative",
              "compliance",
              "release"
            ]
          },
          "uniqueItems": true
        },
        "release": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "factuality",
              "rights",
              "creative",
              "compliance",
              "release"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "brief",
        "shot",
        "asset",
        "release"
      ]
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(profile|brief|claim|asset|shot|review|release)_[a-z0-9][a-z0-9-]{1,62}$"
      },
      "uniqueItems": true
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(profile|brief|claim|asset|shot|review|release)_[a-z0-9][a-z0-9-]{1,62}$"
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string"
    }
  }
}
